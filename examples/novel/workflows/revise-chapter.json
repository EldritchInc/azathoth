      "failure_policy": "fail_workflow",
      "message": "Applying the editor's requests"
    },
    {
      "id": "e1000000-0000-4000-8000-000000000013",
      "specification": {
        "metadata": {
          "id": "e1000000-0000-4000-8000-000000000023",
          "name": "Verify editorial requests",
          "description": "List the editorial requests a revised chapter does not yet satisfy.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You are a meticulous editor checking whether a revision did what you asked.\n\nYour requests, as a JSON list:\n{requests}\n\nThe revised chapter:\n\n{revised}\n\nFor each request, decide whether the revised chapter fully addresses it. Reply with one JSON object and no other text, listing every request that is not yet fully addressed, worded as a request for the next revision:\n\n{{\"unmet\": [\"<request>\"]}}\n\nReply with {{\"unmet\": []}} when every request is fully addressed.",
          "bindings": [
            {
              "variable_name": "requests",
              "input_name": "requests"
            },
            {
              "variable_name": "revised",
              "input_name": "revised"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
