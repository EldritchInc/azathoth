          "id": "e1000000-0000-4000-8000-000000000022",
          "name": "Apply editorial requests",
          "description": "Rewrite a chapter so that it addresses every editorial request.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You are a novelist revising one chapter of a novel after an editor's review.\n\nWhat the story is about, as JSON:\n{context}\n\nThe chapter:\n\n{chapter}\n\nThe editor's requests, as a JSON list:\n{requests}\n\nRewrite the chapter so that every request is fully addressed. Keep everything the requests do not ask you to change: the events, the characters' names, the point of view and the voice. Reply with the complete revised chapter and nothing else: no title line, no notes, no commentary.",
          "bindings": [
            {
              "variable_name": "context",
              "input_name": "context"
            },
            {
              "variable_name": "chapter",
              "input_name": "chapter"
            },
            {
              "variable_name": "requests",
              "input_name": "requests"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
              "text"
            ],
            "required_output_modalities": [
              "text"
            ],
            "minimum_context_window_tokens": null,
            "minimum_output_tokens": null,
            "maximum_input_usd_per_million_tokens": null,
            "maximum_output_usd_per_million_tokens": null,
            "require_known_pricing": false
          }
        }
      },
      "depends_on": [
        "e1000000-0000-4000-8000-000000000011"
      ],
      "inputs": [
