          "name": "Plan story",
          "description": "Plan the characters, arc and subplots of a novel from an idea.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You are a novelist planning a new novel from an idea.\n\nThe idea:\n{idea}\n\nPlan the story. Keep everything the idea specifies, and decide everything it leaves open: the setting, the tone, the main characters with their wants and flaws, one major arc from beginning to end, and the subplots that serve it. Reply with one JSON object and no other text:\n\n{{\"title\": \"<title>\", \"premise\": \"<one paragraph>\", \"setting\": \"<where and when>\", \"tone\": \"<tone>\", \"characters\": [{{\"name\": \"<name>\", \"role\": \"<role>\", \"want\": \"<want>\", \"flaw\": \"<flaw>\"}}], \"arc\": \"<the major arc>\", \"subplots\": [\"<subplot>\"]}}",
          "bindings": [
            {
              "variable_name": "idea",
              "input_name": "idea"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
              "text"
            ],
            "required_output_modalities": [
              "text"
            ],
            "minimum_context_window_tokens": null,
            "minimum_output_tokens": null,
            "maximum_input_usd_per_million_tokens": null,
            "maximum_output_usd_per_million_tokens": null,
            "require_known_pricing": false
          }
        },
        "output_format": "json"
