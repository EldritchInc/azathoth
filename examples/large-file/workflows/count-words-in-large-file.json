{
  "metadata": {
    "id": "a1000000-0000-4000-8000-000000000009",
    "name": "count words in a large file",
    "description": "Count the words of a text object in S3 of any size: split it into chunks of whole lines with split_s3_object, count each chunk in the deployed count-words-in-one-chunk workflow with map_workflow, then sum the counts. The caller supplies the object's s3:// URI.",
    "version": "1.0.0"
  },
  "steps": [
    {
      "id": "a1000000-0000-4000-8000-000000000091",
      "specification": {
        "requirement": {
          "name": "split_s3_object",
          "version": "1.0.0",
          "runtime": "process"
        }
      },
      "depends_on": [],
      "inputs": [
        {
          "name": "settings",
          "source": {
            "value": {
              "destination_prefix": "s3://azathoth-data/work/chunks/",
              "chunk_bytes": 1048576,
              "max_chunks": 1000
            }
          }
        },
        {
          "name": "uri",
          "source": {
            "event_type": "workflow.input.received",
            "field_name": "input"
          }
        }
      ],
      "outputs": [
        {
          "name": "chunks",
          "path": [
            "chunks"
          ]
        }
      ],
      "conditions": [],
      "retry_policy": {
        "max_attempts": 1,
        "initial_delay_seconds": 0.0,
        "backoff_multiplier": 1.0,
        "maximum_delay_seconds": null
      },
      "failure_policy": "fail_workflow",
      "message": "Splitting the file"
    },
    {
      "id": "a1000000-0000-4000-8000-000000000092",
      "specification": {
        "requirement": {
          "name": "map_workflow",
          "version": "1.0.0",
          "runtime": "process"
        }
      },
      "depends_on": [
        "a1000000-0000-4000-8000-000000000091"
      ],
      "inputs": [
        {
          "name": "settings",
          "source": {
            "value": {
              "workflow_id": "a1000000-0000-4000-8000-000000000008",
              "max_items": 1000,
              "max_concurrency": 4
            }
          }
        },
        {
          "name": "items",
          "source": {
            "name": "chunks"
          }
        }
      ],
      "outputs": [
        {
          "name": "results",
          "path": [
            "results"
          ]
        }
      ],
      "conditions": [],
      "retry_policy": {
        "max_attempts": 1,
        "initial_delay_seconds": 0.0,
        "backoff_multiplier": 1.0,
        "maximum_delay_seconds": null
      },
      "failure_policy": "fail_workflow",
      "message": "Counting each chunk"
    },
    {
      "id": "a1000000-0000-4000-8000-000000000093",
      "specification": {
        "requirement": {
          "name": "sum_results",
          "version": "1.0.0",
          "runtime": "process"
        }
      },
      "depends_on": [
        "a1000000-0000-4000-8000-000000000092"
      ],
      "inputs": [
        {
          "name": "results",
          "source": {
            "name": "results"
          }
        }
      ],
      "outputs": [
        {
          "name": "total",
          "path": [
            "total"
          ]
        }
      ],
      "conditions": [],
      "retry_policy": {
        "max_attempts": 1,
        "initial_delay_seconds": 0.0,
        "backoff_multiplier": 1.0,
        "maximum_delay_seconds": null
      },
      "failure_policy": "fail_workflow"
    }
  ],
  "result": {
    "name": "total"
  }
}
