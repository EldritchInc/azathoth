      "failure_policy": "fail_workflow",
      "message": "Reviewing readability"
    },
    {
      "id": "d2000000-0000-4000-8000-000000000014",
      "specification": {
        "metadata": {
          "id": "d2000000-0000-4000-8000-000000000024",
          "name": "Summarize review",
          "description": "Write the review comment for a change from its merged findings.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You are the lead reviewer on a code change. Three reviewers checked it for security, correctness and readability, and their findings are merged below.\n\nThe change, as JSON:\n{change}\n\nThe merged review, as JSON, with its verdict and findings in order of severity:\n{review}\n\nWrite the review comment for the change's author: one short paragraph saying what must change before it merges and why, then the remaining findings as a short list. Be direct and specific, and do not repeat findings. Reply with the comment only.",
          "bindings": [
            {
              "variable_name": "change",
              "input_name": "change"
            },
            {
              "variable_name": "review",
              "input_name": "review"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
              "text"
            ],
            "required_output_modalities": [
              "text"
