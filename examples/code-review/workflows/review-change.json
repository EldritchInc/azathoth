{
  "metadata": {
    "id": "d2000000-0000-4000-8000-000000000010",
    "name": "review change",
    "description": "Review a code change with three reviewers at once, for security, correctness and readability, then merge their findings into one verdict and a lead reviewer's comment.",
    "version": "1.0.0"
  },
  "steps": [
    {
      "id": "d2000000-0000-4000-8000-000000000011",
      "specification": {
        "metadata": {
          "id": "d2000000-0000-4000-8000-000000000021",
          "name": "Review security",
          "description": "Review a change for security problems.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You review code changes for security. Look for injection, unsafe deserialization, missing authentication or authorization checks, secrets in code, unsafe handling of untrusted input, and data that leaks to logs or responses.\n\nReport only security problems: other reviewers cover correctness and readability. Report each problem once, on the line where it is.\n\nThe change, as JSON, with its title, description and unified diff:\n{change}\n\nReply with one JSON object and no other text:\n\n{{\"findings\": [{{\"severity\": \"high\", \"file\": \"<path>\", \"line\": 12, \"summary\": \"<the problem, in one sentence>\", \"suggestion\": \"<how to fix it>\"}}]}}\n\nThe severity is high when the change must not merge as it is, medium when it should be fixed soon, and low for a small improvement. Use null for the line when a finding is about the whole file. Reply with an empty findings list when you find nothing in your area.",
          "bindings": [
            {
              "variable_name": "change",
              "input_name": "change"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
              "text"
            ],
            "required_output_modalities": [
              "text"
            ],
            "minimum_context_window_tokens": null,
            "minimum_output_tokens": null,
            "maximum_input_usd_per_million_tokens": null,
            "maximum_output_usd_per_million_tokens": null,
            "require_known_pricing": false
          }
        },
        "output_format": "json"
      },
      "depends_on": [],
      "inputs": [
        {
          "name": "change",
          "source": {
            "event_type": "workflow.input.received",
            "field_name": "input"
          }
        }
      ],
      "outputs": [
        {
          "name": "security",
          "path": [
            "findings"
          ]
        }
      ],
      "conditions": [],
      "retry_policy": {
        "max_attempts": 2,
        "initial_delay_seconds": 0.0,
        "backoff_multiplier": 1.0,
        "maximum_delay_seconds": null
      },
      "failure_policy": "fail_workflow",
      "message": "Reviewing security"
    },
    {
      "id": "d2000000-0000-4000-8000-000000000012",
      "specification": {
        "metadata": {
