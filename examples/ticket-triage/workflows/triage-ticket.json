      "id": "f1000000-0000-4000-8000-000000000036",
      "specification": {
        "metadata": {
          "id": "f1000000-0000-4000-8000-000000000046",
          "name": "Check reply policy",
          "description": "List the support-policy problems in a drafted reply.",
          "version": "1.0.0"
        },
        "template": {
          "text": "You review customer support replies against company policy before they are sent.\n\nThe policy:\n1. Never promise a refund or a credit. Say the billing team will review the request.\n2. Never ask for a password, a full card number or a one-time code.\n3. Never promise a date for a fix.\n4. Always tell the customer what happens next.\n\nThe ticket, as JSON:\n{ticket}\n\nThe reply:\n\n{draft}\n\nReply with one JSON object and no other text, listing every policy problem in the reply:\n\n{{\"approved\": true, \"problems\": []}}",
          "bindings": [
            {
              "variable_name": "ticket",
              "input_name": "ticket"
            },
            {
              "variable_name": "draft",
              "input_name": "draft"
            }
          ]
        },
        "model_selection": {
          "requirements": {
            "required_capabilities": [],
            "required_input_modalities": [
              "text"
            ],
            "required_output_modalities": [
              "text"
